{
  "name": "@elchi-studios/eauth-react",
  "version": "1.0.0",
  "description": "EAuth for React 18 and 19: a provider, a hook and ready-made sign-in components.",
  "keywords": [
    "eauth",
    "react",
    "oauth2",
    "openid-connect",
    "oidc",
    "pkce",
    "authentication",
    "login"
  ],
  "license": "MIT",
  "author": "Elchi Studios (https://elchi.dev)",
  "homepage": "https://docs.elchi.dev/sdk",
  "bugs": "https://github.com/Elchi-Studios/eauth-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elchi-Studios/eauth-js.git",
    "directory": "packages/react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@elchi-studios/eauth": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
