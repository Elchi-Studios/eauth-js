{
  "name": "@elchi-studios/eauth",
  "version": "1.0.0",
  "description": "Sign in with EAuth from any web page: OAuth 2.1 and OpenID Connect with PKCE, no client secret, no dependencies.",
  "keywords": [
    "eauth",
    "oauth2",
    "oauth",
    "openid-connect",
    "oidc",
    "pkce",
    "authentication",
    "login"
  ],
  "license": "MIT",
  "author": "Elchi Studios (https://elchi.dev)",
  "homepage": "https://docs.elchi.dev/sdk",
  "bugs": "https://github.com/Elchi-Studios/eauth-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elchi-Studios/eauth-js.git",
    "directory": "packages/eauth"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "prepack": "npm run build"
  }
}
