{
  "name": "@elchi-studios/eauth-nuxt",
  "version": "1.0.0",
  "description": "EAuth for Nuxt 3 and 4: a module with useEAuth, an eauth route middleware and runtime config.",
  "keywords": [
    "eauth",
    "nuxt",
    "nuxt-module",
    "vue",
    "oauth2",
    "openid-connect",
    "oidc",
    "authentication"
  ],
  "license": "MIT",
  "author": "Elchi Studios (https://elchi.dev)",
  "homepage": "https://docs.elchi.dev/sdk",
  "bugs": "https://github.com/Elchi-Studios/eauth-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elchi-Studios/eauth-js.git",
    "directory": "packages/nuxt"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@elchi-studios/eauth": "^1.0.0",
    "@nuxt/kit": "^3.13.0 || ^4.0.0"
  },
  "peerDependencies": {
    "nuxt": "^3.13.0 || ^4.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "nuxt": "^4.6.0"
  }
}
