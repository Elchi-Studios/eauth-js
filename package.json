{
  "name": "eauth-js",
  "private": true,
  "description": "JavaScript SDKs for EAuth, the sign-in service of Elchi Studios.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/eauth",
    "packages/react",
    "packages/sveltekit",
    "packages/nuxt"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.json --noEmit",
    "test": "npm run test --workspaces && node --test --test-reporter=spec test/*.test.ts",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
